APP_NAME=Montree
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=montree
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Rol del contenedor en Railway (docker/entrypoint.sh): web | worker | scheduler.
# Producción necesita los tres servicios; worker y scheduler usan railway.worker.json.
CONTAINER_ROLE=web

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@montree.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PlacetoPay Checkout (redirección). Fallback de plataforma: cada tenant puede
# configurar su propio comercio desde el panel. Ambiente: test | production.
P2P_ENVIRONMENT=test
P2P_LOGIN=
P2P_TRANKEY=

# Módulos desactivables: en false la sección no existe (404, sin menú, sin permisos).
MONTREE_MODULE_NEWSLETTER=false
MONTREE_MODULE_PROMOTIONS=false
MONTREE_MODULE_LOGISTICS=false

# Responsable legal de montree.co (Ley 1581 de 2012, Ley 1480 de 2011 art. 50)
MONTREE_LEGAL_NAME=
MONTREE_LEGAL_NIT=
MONTREE_LEGAL_ADDRESS=
MONTREE_LEGAL_CITY=
MONTREE_LEGAL_PHONE=
MONTREE_LEGAL_EMAIL=it@jae-solutions.com
MONTREE_PRIVACY_EMAIL=it@jae-solutions.com

# Contacto de la landing (botón «Hablar con el equipo»): https://wa.me/<numero>
MONTREE_CONTACT_WHATSAPP=573008904278
